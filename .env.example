# Токен от @BotFather
BOT_TOKEN=
# Публичный HTTPS-адрес сервера (где лежит web/). В BotFather для Mini App укажи WEBAPP_URL/play.html
WEBAPP_URL=https://example.trycloudflare.com
# short name Mini App из BotFather (/newapp). Пусто — главный Mini App бота (Bot Settings → Configure Mini App)
APP_SHORT_NAME=play
PORT=8080
DB_PATH=data/arcade.db

# --- необязательные ограничения сервера (умолчания показаны) ---
# TOUR_MIN_MINUTES=5
# TOUR_MAX_MINUTES=10080
# EVENT_GRACE_SECONDS=90
# MAX_ACTIVE_EVENTS=5
# MAX_UPLOADS_PER_DAY=40
# UPLOADS_KEEP_DAYS=7
# GROUP_POST_GAP_SECONDS=15
# GROUP_POSTS_PER_HOUR=30
